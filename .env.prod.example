# Production environment for docker-compose.prod.yml
# Copy to ".env" on the server (same directory as docker-compose.prod.yml) and fill in real values.
# NEVER commit the real .env — only this example template is tracked.

# --- Image tag (date-based, e.g. 2026-06-14.1) pushed by the release workflow ---
investhorizon_image_tag=latest

# --- PostgreSQL ---
investhorizon_postgres_user_prod=investhorizon
# Use a long random value, e.g.: openssl rand -base64 24
investhorizon_postgres_password_prod=CHANGE_ME

# --- JWT (HS256 signing secret, >= 32 chars) ---
# Generate with: openssl rand -base64 48
investhorizon_jwt_key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
investhorizon_jwt_issuer=investhorizon

# --- Seeded initial user (created on first startup if it doesn't exist) ---
investhorizon_seed_user_email=thomas.thiry@gmail.com
investhorizon_seed_user_password=CHANGE_ME
